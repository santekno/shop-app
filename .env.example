# Copy to .env and fill in. Placeholders only — never commit real values.

# --- API (apps/api) ---
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=info
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_REQUEST_TIMEOUT=15s
APP_DRAIN_DELAY=0s
APP_SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://goshop:goshop@localhost:5432/goshop?sslmode=disable
APP_DB_MAX_OPEN_CONNS=10
APP_DB_MAX_IDLE_CONNS=5
APP_DB_CONN_MAX_LIFETIME=30m
# Redis for sessions and rate limits (rediss:// for TLS; may hold a password).
REDIS_URL=redis://localhost:6379/0
# Proxies in front of the API that set X-Forwarded-For (0 = none, as with
# make up; 1 on Railway). Required outside development. Rate limits count per
# client IP; see docs/configuration.md.
APP_TRUSTED_PROXY_HOPS=0
# Signs access tokens. This placeholder works in development only; staging
# and production refuse it. Generate a real one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h

# --- Shipping fees (Bab 5, ADR 0006) ---
# Biteship rates API key; empty = a fixed rate table per kilogram, no
# network (fine for development and tests). Use a test key outside
# production; never commit a real one.
BITESHIP_API_KEY=
# Where parcels leave from; required when BITESHIP_API_KEY is set.
APP_SHIPPING_ORIGIN_POSTAL_CODE=40111
APP_SHIPPING_TIMEOUT=5s
# How long a buyer has to pay before the order is cancelled.
APP_PAYMENT_TTL=24h
# Previews, shipping quotes and checkouts per buyer per minute, each.
APP_CHECKOUT_LIMIT_PER_MINUTE=30

# --- Object storage (SeaweedFS S3 locally, any S3-compatible bucket in production) ---
# Product images (ADR 0007). Empty S3_ENDPOINT = uploads off (503
# STORAGE_DISABLED). The key pair is the local SeaweedFS one from
# deploy/seaweedfs/s3.json; staging and production refuse goshop-secret.
S3_ENDPOINT=http://localhost:8333
# Where clients upload to and read images from, when not S3_ENDPOINT
# (empty = S3_ENDPOINT, and S3_PRESIGN_ENDPOINT/S3_BUCKET).
S3_PRESIGN_ENDPOINT=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=goshop
S3_ACCESS_KEY=goshop
S3_SECRET_KEY=goshop-secret

# --- Payments (Midtrans sandbox only, ADR 0007) ---
# Sandbox keys from dashboard.sandbox.midtrans.com → Settings → Access keys
# (SB-Mid-server-…, SB-Mid-client-…). Empty server key = payments off (503
# PAYMENTS_DISABLED). Never commit real keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Must stay false: GoShop uses the Midtrans sandbox only.
MIDTRANS_IS_PRODUCTION=false
# How long one call to Midtrans may take.
APP_PAYMENT_TIMEOUT=10s

# --- Google sign-in ---
# The OAuth client ID (…apps.googleusercontent.com) whose ID tokens the API
# accepts. Empty turns Google sign-in off, in development only. The API
# verifies ID tokens and needs no client secret.
GOOGLE_CLIENT_ID=

# --- LLM (Bab 18) ---
OPENAI_API_KEY=
