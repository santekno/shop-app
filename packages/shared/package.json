{
  "name": "@goshop/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Code shared by the GoShop web, admin and mobile apps: API types and the API client",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml --output src/api/schema.gen.ts",
    "gen:check": "openapi-typescript ../../api/openapi.yaml --output src/api/schema.gen.ts --check",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test:unit": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
