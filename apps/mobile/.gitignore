# Generated by Expo; never edited by hand. The repository's .gitignore also
# lists the first three (and *.apk, *.aab, *.ipa); they are repeated here so
# this folder is self-explanatory.
#
# Continuous Native Generation: `npx expo prebuild` writes android/ and ios/
# from app.config.ts and the config plugins, so they are build output.
/android
/ios
# The CLI's local state (device list, dev server settings, typed-route types).
/.expo
# `expo export` (pnpm build): the JavaScript bundles and assets.
/dist
# Written by `expo start`; src/expo-types.d.ts is the committed equivalent.
/expo-env.d.ts
# Metro's health check file.
.metro-health-check*
# Native signing material, should one ever be created locally.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
