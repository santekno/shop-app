# Copy to apps/mobile/.env.local for `pnpm --filter @goshop/mobile start`.
# Expo writes EXPO_PUBLIC_* values into the JavaScript bundle: never put a
# secret in one, anyone with the app can read it.

# The GoShop API as the device reaches it. Unset means the API on this
# machine: http://10.0.2.2:8080 on the Android emulator, http://localhost:8080
# on the iOS simulator. A phone on the same Wi-Fi needs the machine's LAN
# address, for example http://192.168.1.10:8080. A production EAS build
# refuses to start without it.
EXPO_PUBLIC_API_URL=
