{
  "name": "@goshop/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "GoShop app for Android and iOS (React Native + Expo Router)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "build": "expo export --platform all --output-dir dist",
    "test:unit": "jest"
  },
  "dependencies": {
    "@expo/log-box": "58.0.13",
    "@expo/metro-runtime": "58.0.15",
    "@goshop/shared": "workspace:*",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "catalog:",
    "expo": "58.0.21",
    "expo-build-properties": "58.0.11",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.17",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.15",
    "expo-network": "58.0.4",
    "expo-router": "58.0.28",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@eslint/js": "catalog:",
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "58.0.22",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "expect": "30.5.2",
    "globals": "catalog:",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "prettier": "catalog:",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
