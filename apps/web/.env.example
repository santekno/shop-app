# Copy to apps/web/.env.local for `pnpm --filter @goshop/web dev`.
# Next.js writes NEXT_PUBLIC_* values into the browser's JavaScript at build
# time: never put a secret in one, every visitor can read it. The others
# are read by the server only, when it starts.

# The GoShop API as the browser reaches it. Unset in development means
# http://localhost:8080 (the API from `make up` or `make dev-api`); a
# production build refuses to start without it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# The API as the storefront's server reaches it (server components, the
# sitemap). Inside Docker Compose that is http://api:8080; unset means
# NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# The storefront's public origin, for canonical links, Open Graph, the
# structured data and the sitemap. Read from here, never from the request's
# Host header. Unset in development means http://localhost:5173; a
# production server answers 500 without it.
SITE_URL=
