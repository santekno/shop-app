# Copy to apps/web/.env.local for `pnpm --filter @goshop/web dev`.
# Vite writes VITE_* values into the JavaScript bundle at build time: never
# put a secret in one, every visitor can read it.

# The GoShop API as the browser reaches it. Unset in development means
# http://localhost:8080 (the API from `make up` or `make dev-api`); a
# production build refuses to start without it.
VITE_API_URL=http://localhost:8080
