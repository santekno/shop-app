# Serves the built storefront (apps/web/dist, copied to /srv). TLS ends at
# Railway's edge or at whatever proxy sits in front, so Caddy speaks plain
# HTTP on $PORT and needs neither its admin API nor automatic HTTPS.
{
	admin off
	auto_https off
	persist_config off
}

# The headers of every response. A snippet, because Caddy writes an error
# (a 404, say) through handle_errors below, which starts with fresh headers.
(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The storefront uses no camera, microphone, location or browser
		# payment API, so neither it nor anything it embeds may ask for them.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The app may load only its own files and call only its own API.
		# api-origin holds the origin of VITE_API_URL, written by the
		# Dockerfile: a CSP source with a path allows only that exact path.
		#
		# Payments (Bab 11) add nothing here, on purpose. The buyer pays on
		# Midtrans' hosted Snap page through the transaction's redirect_url:
		# a top-level navigation to app.sandbox.midtrans.com, which no CSP
		# directive governs, and back to /pembayaran/selesai. Snap.js (the
		# pop-up) would need Midtrans in script-src, frame-src and
		# connect-src, and would run Midtrans' script inside this page, next
		# to the access token in memory (docs/web/README.md, Bab 11 artikel
		# 04). payment=() above stays: nothing uses the Payment Request API.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self' {file./etc/caddy/api-origin}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security_headers

	# Each request goes to exactly one handle block: the one with the most
	# specific path that matches, and the block without a path last.

	# Liveness probe for Docker and Railway: answers without touching files.
	handle /healthz {
		respond "ok" 200
	}

	# Vite names every built asset after a hash of its content, so a new
	# build means a new name and a file can be cached for a year. A missing
	# asset is a plain 404, never index.html: that page, cached for a year
	# under a script's name, would break the site until the cache expires.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: the file if there is one (favicon.svg), otherwise
	# index.html, so a client-side route works when opened directly. Checked
	# again on every visit, so a deploy reaches users at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Errors, such as a missing file under /assets: the status as plain text,
	# with the security headers and never cached.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}
}
