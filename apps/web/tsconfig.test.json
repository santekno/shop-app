{
  // The unit tests, their setup and helpers (src/test), checked with the
  // storefront's own settings (tsconfig.json) plus what only Vitest has:
  // Node's globals and Vite's import.meta.glob (src/test/app-routes.ts).
  // tsconfig.json leaves the tests out so that `next build` and the app's
  // check never see test-only types; `pnpm typecheck` runs this one too.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
