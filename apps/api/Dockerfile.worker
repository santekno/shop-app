# syntax=docker/dockerfile:1
# GoShop worker image (ADR 0007): the second binary of the API's module.
# The build context is the repository root, the same way Railway builds it:
#
#   docker build -f apps/api/Dockerfile.worker -t goshop-worker .
#
# No secret is baked in: every setting comes from env vars at run time.

# --- build: compile a static binary -------------------------------------
# The same steps as apps/api/Dockerfile up to the build, so Docker reuses
# the downloaded modules for both images.
FROM golang:1.26.10-alpine AS build
WORKDIR /src/apps/api

COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download

COPY apps/api/ ./
# CGO off: the image resizing is pure Go (golang.org/x/image), so the
# binary stays static and runs on distroless. -p=1 and GOGC=50 keep the
# build inside a small Docker VM, as for the API.
RUN GOFLAGS=-p=1 GOGC=50 CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# --- runtime: just the binary --------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/worker /worker
USER nonroot:nonroot
# The worker serves only /healthz and /readyz, on $PORT when set (Railway),
# otherwise $APP_PORT or 8080.
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 CMD ["/worker", "healthcheck"]
ENTRYPOINT ["/worker"]
