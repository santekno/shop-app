# Serves the built admin dashboard (apps/admin/dist, copied to /srv): the
# Bab 7–10 storefront's Caddyfile (git show bab-10:apps/web/Caddyfile),
# with a Content-Security-Policy for the dashboard. TLS ends at Railway's
# edge or at whatever proxy sits in front, so Caddy speaks plain HTTP on
# $PORT and needs neither its admin API nor automatic HTTPS.
{
	admin off
	auto_https off
	persist_config off
}

# The headers of every response. A snippet, because Caddy writes an error
# (a 404, say) through handle_errors below, which starts with fresh headers.
(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# A dashboard behind a login has nothing for a search engine.
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The app may load only its own files, and talk to:
		#
		# - the API (connect-src). Its origin comes from VITE_API_URL, the
		#   build argument Vite bakes into the bundle, so the Dockerfile
		#   writes it into /etc/caddy/api-origin at build time: the CSP and
		#   the bundle can never name two different APIs.
		# - the object storage (connect-src): product photos are uploaded
		#   from the browser straight to a presigned URL (artikel 04).
		#   UPLOAD_ORIGIN, at run time.
		# - the photos (img-src): IMAGE_ORIGIN, at run time.
		#
		# {$VAR} is replaced with the environment variable when Caddy reads
		# this file at start-up, so one image works against any storage:
		# set the variables per deployment, no rebuild. Unset is empty, and
		# the source is simply missing (uploads and photos are blocked, the
		# rest works). Each is one origin (scheme, host, port; no path, no
		# quote), or several separated by spaces.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: {$IMAGE_ORIGIN}; connect-src 'self' {file./etc/caddy/api-origin} {$UPLOAD_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security_headers

	# Liveness probe for Docker and Railway: answers without touching files.
	handle /healthz {
		respond "ok" 200
	}

	# Vite names every built asset after a hash of its content: cache for a
	# year. A missing asset is a plain 404, never index.html, which cached
	# for a year under a script's name would break the dashboard.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: the file if there is one (favicon.svg), otherwise
	# index.html, so a client-side route (/produk) works when opened
	# directly. Checked again on every visit, so a deploy reaches users at
	# once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}
}
